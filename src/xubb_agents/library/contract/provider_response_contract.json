{
  "spec_version": "1.3.0",
  "encoding": "map_entries_v1",
  "domain_channels": {
    "variable_updates": {
      "encoding": "map_entries_v1",
      "normalized_type": "object"
    },
    "queue_pushes": {
      "encoding": "map_entries_v1",
      "normalized_type": "object",
      "map_value": "array"
    },
    "memory_updates": {
      "encoding": "map_entries_v1",
      "normalized_type": "object"
    },
    "facts": {
      "encoding": "fact_array",
      "provider_shape": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "key": {
              "type": [
                "string",
                "null"
              ]
            },
            "value": {
              "$ref": "#/$defs/json_value"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "key",
            "value",
            "confidence"
          ],
          "additionalProperties": false
        }
      }
    },
    "events": {
      "encoding": "event_array",
      "provider_shape": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/map"
            }
          },
          "required": [
            "name",
            "payload"
          ],
          "additionalProperties": false
        }
      }
    },
    "ui_actions": {
      "encoding": "ui_action_array",
      "provider_shape": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "target_widget": {
              "type": "string"
            },
            "action": {
              "type": "string"
            },
            "payload": {
              "$ref": "#/$defs/map"
            }
          },
          "required": [
            "target_widget",
            "action",
            "payload"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "notes": [
    "Schema authority for domain transport only. Domain shape, namespace authorization and side-effect permissions require local checks.",
    "A channel here is MODEL-FACING. `state_updates` and `data` were removed in 3.1.0: they are host-facing projections of AgentResponse, and offering them to a provider required output that no supported format's parser reads (F7).",
    "Which of these a given run offers is decided by the output format's contract (library/contract/output_formats.json), never by this file alone.",
    "No model-authored source identity, timestamp, acceptance state or confidence_provided.",
    "Zero provider calls performed."
  ]
}
