          "payload": {
            "$ref": "#/$defs/map"
          }
        },
        "required": [
          "name",
          "payload"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "has_insight",
    "insight",
    "state_updates",
    "variable_updates",
    "queue_pushes",
    "memory_updates",
    "data",
    "facts",
    "events"
