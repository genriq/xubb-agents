    "has_insight": {
      "type": "boolean"
    },
    "insight": {
      "anyOf": [
        {
          "$ref": "#/$defs/candidate"
        },
        {
          "type": "null"
        }
      ]
    },
    "state_updates": {
      "$ref": "#/$defs/map"
    },
    "variable_updates": {
      "$ref": "#/$defs/map"
    },
    "queue_pushes": {
      "$ref": "#/$defs/map"
