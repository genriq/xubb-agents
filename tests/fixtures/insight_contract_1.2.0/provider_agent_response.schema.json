                  "type": "string"
                }
              },
              "required": [
                "reason",
                "response_format"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata": {
          "$ref": "#/$defs/map"
        },
        "preview": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "content_format": {
          "type": "string",
          "enum": [
            "plain_text",
            "markdown"
          ]
        }
      },
      "required": [
        "type",
        "content",
        "confidence",
        "urgency",
        "observation_kind",
        "evidence_refs",
        "rationale",
        "validation_step",
        "assumptions",
        "correction",
        "question",
        "metadata",
        "preview",
        "content_format"
      ]
    }
