        "rationale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "correction": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "target_insight_id": {
                  "type": "string"
                },
                "operation": {
                  "type": "string",
                  "enum": [
                    "replace",
                    "withdraw"
                  ]
                },
                "reason": {
                  "type": "string"
                }
              },
              "required": [
                "target_insight_id",
                "operation",
                "reason"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "question": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "reason": {
                  "type": "string"
                },
                "response_format": {
                  "enum": [
                    "text"
